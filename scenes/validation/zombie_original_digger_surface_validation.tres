[gd_resource type="Resource" script_class="BattleScenario" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle_scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://scripts/battle/battle_validation_rule.gd" id="3_rule"]

[sub_resource type="Resource" id="Rule_probe_passed"]
script = ExtResource("3_rule")
rule_id = &"digger_surface_probe_passed"
description = "The digger surface probe must pass: tunneling underground past the defeat line without triggering the goal, rising at the left edge, surfaced walking right."
event_name = &"original_zombie.validation_probe"
required_core_values = {
"probe": &"zombie_original_digger_surface",
"result": &"passed"
}

[resource]
script = ExtResource("1_scenario")
scenario_id = &"zombie_original_digger_surface_validation"
display_name = "Original Digger Surface Validation"
description = "Validates Z-03: the Digger tunnels underground to the left edge (mPosX < 10), rises there, and surfaces walking right; tunneling under the defeat line does not trigger the goal."
goals = PackedStringArray("Digger tunnels underground past the defeat line without defeat.", "Digger surfaces at the left edge and walks right.")
validation_time_limit = 14.0
lane_count = 2
validation_rules = [SubResource("Rule_probe_passed")]
