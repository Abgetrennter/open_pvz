[gd_resource type="Resource" script_class="BattleScenario" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle_scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://scripts/battle/battle_validation_rule.gd" id="3_rule"]

[sub_resource type="Resource" id="Rule_probe_passed"]
script = ExtResource("3_rule")
rule_id = &"wave_pool_probe_passed"
description = "The wave pool probe must pass: gZombieDefs triples mapped per entry, water zone gates, flag entry weight-0, seeded compile respects budget and the wave-0 unlock curve."
event_name = &"original_zombie.validation_probe"
required_core_values = {
"probe": &"zombie_original_wave_pool",
"result": &"passed"
}

[resource]
script = ExtResource("1_scenario")
scenario_id = &"zombie_original_wave_pool_validation"
display_name = "Original Adventure Wave Pool Validation"
description = "Validates Z-34: the original adventure pool data (data/combat/waves/pool_original_adventure.tres) maps gZombieDefs value/startingLevel/pickWeight to power/first_allowed_wave/weight with water zone gates, and a seeded recipe compile respects budgets and unlock waves."
goals = PackedStringArray("All 24 pool entries resolve and match the gZombieDefs triples.", "Water types are gated to water lanes; the flag entry stays weight-0.", "A seeded compile stays inside the power budget and honors first_allowed_wave.")
validation_time_limit = 4.0
lane_count = 2
validation_rules = [SubResource("Rule_probe_passed")]
