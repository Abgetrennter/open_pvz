[gd_resource type="Resource" script_class="BattleScenario" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle_scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://scripts/battle/battle_spawn_entry.gd" id="2_spawn"]
[ext_resource type="Script" path="res://scripts/battle/battle_validation_rule.gd" id="3_rule"]
[ext_resource type="Script" path="res://scripts/battle/effect_execution_request.gd" id="4_effect_request"]

[sub_resource type="Resource" id="Spawn_garlic_boundary"]
script = ExtResource("2_spawn")
entity_kind = &"plant"
archetype_id = &"archetype_original_garlic"
lane_id = 0
x_position = 160.0

[sub_resource type="Resource" id="Spawn_garlic_isolated"]
script = ExtResource("2_spawn")
entity_kind = &"plant"
archetype_id = &"archetype_original_garlic"
lane_id = 2
x_position = 400.0

[sub_resource type="Resource" id="Spawn_wallnut_lane1"]
script = ExtResource("2_spawn")
entity_kind = &"plant"
archetype_id = &"archetype_original_wallnut"
lane_id = 1
x_position = 160.0

[sub_resource type="Resource" id="Spawn_biter"]
script = ExtResource("2_spawn")
entity_kind = &"zombie"
archetype_id = &"archetype_basic_walker"
lane_id = 0
x_position = 280.0
spawn_overrides = {
"move_speed_slots_per_sec": 1.0
}

[sub_resource type="Resource" id="Req_nonbite_damage"]
script = ExtResource("4_effect_request")
at_time = 0.5
effect_id = &"damage"
params = {
"amount": 20,
"target_mode": &"context_target"
}
target_archetype_id = &"archetype_original_garlic"
target_lane_id = 2

[sub_resource type="Resource" id="Rule_garlic_bitten"]
script = ExtResource("3_rule")
rule_id = &"garlic_bitten"
description = "The basic walker should bite the boundary-lane Garlic at least once."
event_name = &"entity.damaged"
required_core_values = {
"source_archetype_id": &"archetype_basic_walker",
"target_archetype_id": &"archetype_original_garlic"
}

[sub_resource type="Resource" id="Rule_reroute_boundary"]
script = ExtResource("3_rule")
rule_id = &"garlic_reroute_boundary_deterministic"
description = "Biting the lane-0 Garlic must reroute the biter to lane 1 deterministically (only viable direction at the board boundary)."
event_name = &"entity.lane_changed"
max_count = 1
required_core_values = {
"from_lane": 0,
"reason": &"garlic_repel",
"to_lane": 1
}

[sub_resource type="Resource" id="Rule_lane_change_bounded"]
script = ExtResource("3_rule")
rule_id = &"lane_change_count_bounded"
description = "Exactly one lane change may occur: non-bite damage on the lane-2 Garlic must not trigger a reroute."
event_name = &"entity.lane_changed"
max_count = 1

[sub_resource type="Resource" id="Rule_rerouted_active_new_lane"]
script = ExtResource("3_rule")
rule_id = &"rerouted_zombie_active_in_new_lane"
description = "After rerouting, the walker must engage the Wall-nut in lane 1, proving lane state and coordinates were synchronized."
event_name = &"entity.damaged"
required_core_values = {
"source_archetype_id": &"archetype_basic_walker",
"target_archetype_id": &"archetype_original_wallnut",
"target_lane": 1
}

[sub_resource type="Resource" id="Rule_nonbite_damage_applied"]
script = ExtResource("3_rule")
rule_id = &"nonbite_damage_applied"
description = "The scripted non-bite damage effect must hit the lane-2 Garlic so the negative reroute assertion is meaningful."
event_name = &"entity.damaged"
required_core_values = {
"target_archetype_id": &"archetype_original_garlic",
"target_lane": 2
}

[resource]
script = ExtResource("1_scenario")
scenario_id = &"plant_original_garlic_validation"
display_name = "Original Garlic Validation"
description = "Validates Garlic's bite-tag filtered when_damaged trigger and the lane_reroute effect: boundary-lane deterministic reroute, post-reroute activity in the new lane, and no reroute from non-bite damage."
goals = PackedStringArray("Verify a bite on the lane-0 Garlic reroutes the biter to lane 1 with entity.lane_changed.", "Verify the rerouted zombie engages targets in its new lane.", "Verify non-bite damage on a Garlic does not trigger lane_reroute.")
validation_time_limit = 6.0
lane_count = 3
effect_execution_requests = [SubResource("Req_nonbite_damage")]
validation_rules = [SubResource("Rule_garlic_bitten"), SubResource("Rule_reroute_boundary"), SubResource("Rule_lane_change_bounded"), SubResource("Rule_rerouted_active_new_lane"), SubResource("Rule_nonbite_damage_applied")]
spawns = [SubResource("Spawn_garlic_boundary"), SubResource("Spawn_garlic_isolated"), SubResource("Spawn_wallnut_lane1"), SubResource("Spawn_biter")]
