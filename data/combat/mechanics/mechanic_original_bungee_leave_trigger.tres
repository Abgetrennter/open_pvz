"detection_id": &"proximity",
"interval": 0.5,
"max_trigger_count": 1,
"require_no_target": true,
"required_state": &"grabbing",
"scan_range": 30.0,
"start_delay": 4.9,
"target_tags": PackedStringArray("plant")
}
