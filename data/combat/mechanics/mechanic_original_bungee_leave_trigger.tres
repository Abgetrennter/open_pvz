[gd_resource type="Resource" script_class="CombatMechanic" load_steps=2]

[ext_resource type="Script" path="res://scripts/core/defs/combat_mechanic.gd" id="1_mechanic"]

[resource]
script = ExtResource("1_mechanic")
mechanic_id = &"core.original.bungee_leave_trigger"
display_name = "Original Bungee Leave Trigger"
family = &"Trigger"
type_id = &"core.periodic"
priority = 10
tags = PackedStringArray("original", "zombie", "trigger", "bungee")
